#!/bin/sh
set -eu

WORKSPACE="${TALON_WORKSPACE:-}"
if [ -z "$WORKSPACE" ]; then
  echo "TALON_WORKSPACE is not set. Start commands from the Talon CLI add-on terminal." >&2
  exit 1
fi

cd "$WORKSPACE"
export TALOND_CONFIG_PATH="$WORKSPACE/talond.yaml"
export OPENAI_API_KEY="${OPENAI_API_KEY:-talon-cli-placeholder}"
export TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-talon-cli-placeholder}"

exec node /opt/talond/dist/cli/index.js "$@"
